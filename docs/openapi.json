{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HourlyMetric": {
        "description": "One gold row: the hourly aggregate for a country and payment method.",
        "properties": {
          "auth_rate": {
            "title": "Auth Rate",
            "type": "number"
          },
          "country_code": {
            "title": "Country Code",
            "type": "string"
          },
          "gross_volume": {
            "title": "Gross Volume",
            "type": "string"
          },
          "payment_count": {
            "title": "Payment Count",
            "type": "integer"
          },
          "payment_hour": {
            "format": "date-time",
            "title": "Payment Hour",
            "type": "string"
          },
          "payment_method": {
            "title": "Payment Method",
            "type": "string"
          }
        },
        "required": [
          "payment_hour",
          "country_code",
          "payment_method",
          "payment_count",
          "gross_volume",
          "auth_rate"
        ],
        "title": "HourlyMetric",
        "type": "object"
      },
      "HourlyMetricsPage": {
        "description": "A page of hourly metrics plus the token for the next one.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/HourlyMetric"
            },
            "title": "Data",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque token for the next page; null when this is the last page.",
            "title": "Next Cursor"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Iceberg snapshot id of the gold table this page was read from.",
            "title": "Snapshot Id"
          }
        },
        "required": [
          "data"
        ],
        "title": "HourlyMetricsPage",
        "type": "object"
      },
      "MetricsSummary": {
        "description": "Roll-up totals across the filtered window.",
        "properties": {
          "auth_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Payment-count-weighted authorization rate; null when the window is empty.",
            "title": "Auth Rate"
          },
          "bucket_count": {
            "description": "Number of hourly gold rows matched.",
            "title": "Bucket Count",
            "type": "integer"
          },
          "gross_volume": {
            "title": "Gross Volume",
            "type": "string"
          },
          "payment_count": {
            "title": "Payment Count",
            "type": "integer"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          }
        },
        "required": [
          "bucket_count",
          "payment_count",
          "gross_volume"
        ],
        "title": "MetricsSummary",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "trino_reachable": {
            "title": "Trino Reachable",
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "trino_reachable"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only access to hourly payment metrics from the gold Iceberg table (`iceberg.analytics.payment_metrics_gold`), served through Trino.",
    "title": "Payments Gold API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "description": "Liveness only -- deliberately does not touch Trino, so a warehouse outage cannot cause\nKubernetes to restart an otherwise healthy pod.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/metrics/hourly": {
      "get": {
        "operationId": "hourly_metrics_v1_metrics_hourly_get",
        "parameters": [
          {
            "description": "Inclusive lower bound on payment_hour.",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive lower bound on payment_hour.",
              "title": "Start"
            }
          },
          {
            "description": "Exclusive upper bound on payment_hour.",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive upper bound on payment_hour.",
              "title": "End"
            }
          },
          {
            "in": "query",
            "name": "country_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country Code"
            }
          },
          {
            "in": "query",
            "name": "payment_method",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Payment Method"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque token from a previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque token from a previous page.",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HourlyMetricsPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Hourly Metrics",
        "tags": [
          "metrics"
        ]
      }
    },
    "/v1/metrics/summary": {
      "get": {
        "operationId": "metrics_summary_v1_metrics_summary_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "in": "query",
            "name": "country_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country Code"
            }
          },
          {
            "in": "query",
            "name": "payment_method",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Payment Method"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Metrics Summary",
        "tags": [
          "metrics"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "description": "Readiness: can this instance actually serve? Requires Trino to answer.",
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
